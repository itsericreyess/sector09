<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Versión web de Sector 09: reutiliza Domain, Application, Infrastructure y el
       renderizador de Presentation; solo la capa de ventana es propia del navegador. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DoomFPS.Web</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- El raycaster es intensivo: en Release se compila AOT a WebAssembly (requiere
         el workload wasm-tools, que el Dockerfile instala). Desactivar con -p:Aot=false. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release' and '$(Aot)' != 'false'">true</RunAOTCompilation>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoomFPS.Domain\DoomFPS.Domain.csproj" />
    <ProjectReference Include="..\DoomFPS.Application\DoomFPS.Application.csproj" />
    <ProjectReference Include="..\DoomFPS.Infrastructure\DoomFPS.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Mismo código de dibujo que la versión de escritorio (no usa System.Drawing). -->
  <ItemGroup>
    <Compile Include="..\DoomFPS.Presentation\PixelRenderer.cs" Link="Shared\PixelRenderer.cs" />
    <Compile Include="..\DoomFPS.Presentation\Sprites.cs" Link="Shared\Sprites.cs" />
    <Compile Include="..\DoomFPS.Presentation\ShipVisuals.cs" Link="Shared\ShipVisuals.cs" />
  </ItemGroup>
</Project>
