{
  "rules": {
    ".read": false,
    ".write": false,
    "scores": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$scoreId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['level','score','seconds','kills','createdAt'])"
        }
      }
    },
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
