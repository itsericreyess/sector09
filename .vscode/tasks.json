{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ejecutar DoomFPS",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/DoomFPS.Presentation/DoomFPS.Presentation.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Pruebas de DoomFPS",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/DoomFPS.Tests/DoomFPS.Tests.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}